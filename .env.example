# =============================================================================
# Admin User Configuration
# =============================================================================
# Used by scripts/create-admin.js and scripts/create-admin.sh
SHOP_ADMIN_EMAIL=admin@laptop-repair-shop.local
SHOP_ADMIN_PASSWORD=AdminPass123!
SHOP_ADMIN_NAME="Shop Manager"
SHOP_ADMIN_ROLE=shop_owner

# =============================================================================
# Application Settings
# =============================================================================
VITE_APP_ENVIRONMENT=development
VITE_APP_NAME="Hệ thống Quản lý Sửa chữa Laptop"
VITE_APP_VERSION=1.0.0
VITE_API_TIMEOUT=10000
VITE_ENABLE_DEVTOOLS=true

# Vietnamese Localization
VITE_DEFAULT_CURRENCY=VND
VITE_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
VITE_DEFAULT_LOCALE=vi-VN

# =============================================================================
# Development Server Configuration
# =============================================================================
PORT=5173
HOST=localhost

# =============================================================================
# Instructions
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Update Supabase keys if needed (usually defaults work for local development)
# 3. Customize admin user credentials if desired
# 4. Run: pnpm run db:start
# 5. Run: pnpm run create-admin
# 6. Run: pnpm run dev

