# Vietnamese Laptop Repair Shop Management System
# Production Environment Configuration Template

# =============================================================================
# Supabase Connection (Production)
# =============================================================================
# IMPORTANT: Replace these with your actual production Supabase project values
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_production_anon_key_here
# DO NOT include service role key in production frontend builds

# =============================================================================
# Production Application Settings
# =============================================================================
VITE_APP_ENVIRONMENT=production
VITE_APP_NAME="Hệ thống Quản lý Sửa chữa Laptop"
VITE_APP_VERSION=1.0.0
VITE_API_TIMEOUT=15000
VITE_ENABLE_DEVTOOLS=false

# Vietnamese Business Configuration
VITE_DEFAULT_CURRENCY=VND
VITE_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
VITE_DEFAULT_LOCALE=vi-VN

# =============================================================================
# Production Performance Settings
# =============================================================================
VITE_ENABLE_PWA=true
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_DURATION=3600
VITE_ENABLE_COMPRESSION=true

# =============================================================================
# Vietnamese Business Production Settings
# =============================================================================
VITE_VIETNAMESE_PHONE_VALIDATION_STRICT=true
VITE_ENABLE_VIETNAMESE_LOCALE_CACHING=true
VITE_DEFAULT_CUSTOMER_CACHE_DURATION=1800
VITE_DEFAULT_PARTS_CACHE_DURATION=3600

# =============================================================================
# Error Monitoring & Analytics
# =============================================================================
VITE_ENABLE_ERROR_REPORTING=true
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ANALYTICS_ID=your_analytics_id_here

# =============================================================================
# Security Settings
# =============================================================================
VITE_ENABLE_CSP=true
VITE_ALLOWED_ORIGINS=https://your-domain.com
VITE_ENABLE_HTTPS_REDIRECT=true
VITE_SESSION_TIMEOUT=3600

# =============================================================================
# Vietnamese Business Feature Flags
# =============================================================================
VITE_ENABLE_ADVANCED_REPORTING=true
VITE_ENABLE_CUSTOMER_PORTAL=true
VITE_ENABLE_MOBILE_RECEIPT_PRINTING=true
VITE_ENABLE_PARTS_BARCODE_SCANNING=true
VITE_ENABLE_VIETNAMESE_INVOICE_EXPORT=true

# =============================================================================
# Production Database Settings (Backend Only - DO NOT include in frontend)
# =============================================================================
# These should only be set in your backend/server environment:
# DATABASE_URL=postgresql://username:password@host:port/database
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_JWT_SECRET=your_jwt_secret

# =============================================================================
# Deployment Configuration
# =============================================================================
# Build settings for production deployment
BUILD_PATH=dist
PUBLIC_URL=/
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false

# =============================================================================
# Vietnamese Business Backup & Recovery
# =============================================================================
VITE_ENABLE_DATA_EXPORT=true
VITE_BACKUP_RETENTION_DAYS=30
VITE_ENABLE_AUDIT_LOGGING=true

# =============================================================================
# Production Instructions
# =============================================================================
# 1. Copy this file to .env.production: cp .env.production.example .env.production
# 2. Replace all placeholder values with your actual production values
# 3. Set up your production Supabase project
# 4. Configure your deployment platform environment variables
# 5. Test in staging environment before production deployment
# 6. Monitor application performance and errors after deployment
#
# SECURITY CHECKLIST:
# - [ ] Updated all placeholder values
# - [ ] Removed development keys and tokens
# - [ ] Enabled HTTPS and security headers
# - [ ] Configured error monitoring
# - [ ] Set up database backups
# - [ ] Tested Vietnamese business workflows in production environment