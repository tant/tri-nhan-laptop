# Production Environment Template for Vietnamese Laptop Repair Shop
# =================================================================
# 🚨 SECURITY NOTICE: Generate new values for all secrets before production use!
# 🔐 Replace ALL placeholder values with actual secure secrets

# ===============================
# DATABASE CONFIGURATION
# ===============================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
# 🔐 GENERATE: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_DATABASE_PASSWORD

# ===============================
# SERVICE PASSWORDS
# ===============================
# 🔐 Use same secure password as POSTGRES_PASSWORD for consistency
SUPABASE_AUTH_ADMIN_PASSWORD=REPLACE_WITH_SECURE_DATABASE_PASSWORD
SUPABASE_STORAGE_ADMIN_PASSWORD=REPLACE_WITH_SECURE_DATABASE_PASSWORD
AUTHENTICATOR_PASSWORD=REPLACE_WITH_SECURE_DATABASE_PASSWORD

# ===============================
# JWT CONFIGURATION
# ===============================
# 🔐 GENERATE: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRY=3600

# 🚨 PRODUCTION: Generate new JWT tokens with your JWT_SECRET
# Use: https://jwt.io/ or supabase CLI to generate production tokens
ANON_KEY=GENERATE_NEW_ANON_JWT_TOKEN
SERVICE_ROLE_KEY=GENERATE_NEW_SERVICE_ROLE_JWT_TOKEN

# ===============================
# API ENDPOINTS
# ===============================
# 🌐 UPDATE: Replace with your actual domain
API_EXTERNAL_URL=https://api.your-laptop-repair-shop.com
SUPABASE_PUBLIC_URL=https://api.your-laptop-repair-shop.com

# ===============================
# KONG GATEWAY
# ===============================
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ===============================
# DATABASE SCHEMAS
# ===============================
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ===============================
# AUTHENTICATION SETTINGS
# ===============================
# 🌐 UPDATE: Replace with your actual domain
SITE_URL=https://your-laptop-repair-shop.com
ADDITIONAL_REDIRECT_URLS=""
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false

# ===============================
# SHOP ADMIN ACCOUNT
# ===============================
# 📧 UPDATE: Use real admin email
SHOP_ADMIN_EMAIL=admin@your-laptop-repair-shop.com
# 🔐 GENERATE: Strong password for shop owner/manager
SHOP_ADMIN_PASSWORD=REPLACE_WITH_SECURE_ADMIN_PASSWORD
SHOP_ADMIN_NAME="Chủ cửa hàng"
SHOP_ADMIN_ROLE=shop_owner

# ===============================
# EMAIL CONFIGURATION (SMTP)
# ===============================
# 📧 CONFIGURE: Real SMTP settings for production
SMTP_ADMIN_EMAIL=noreply@your-laptop-repair-shop.com
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_SENDER_NAME="Cửa hàng Sửa chữa Laptop"

# ===============================
# MAILER URL PATHS
# ===============================
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# ===============================
# STUDIO CONFIGURATION
# ===============================
STUDIO_DEFAULT_ORGANIZATION="Cửa hàng Sửa chữa Laptop"
STUDIO_DEFAULT_PROJECT="Hệ thống Quản lý Sửa chữa"

# ===============================
# STORAGE & MEDIA
# ===============================
IMGPROXY_ENABLE_WEBP_DETECTION=true

# ===============================
# EDGE FUNCTIONS
# ===============================
FUNCTIONS_VERIFY_JWT=true

# ===============================
# SYSTEM SECRETS
# ===============================
# 🔐 GENERATE: openssl rand -base64 64
SECRET_KEY_BASE=REPLACE_WITH_SECURE_SECRET_KEY_BASE_64_CHARS

# ===============================
# FRONTEND ENVIRONMENT (VITE)
# ===============================
# 🌐 UPDATE: Replace with your actual domain
VITE_SUPABASE_URL=https://api.your-laptop-repair-shop.com
VITE_SUPABASE_ANON_KEY=SAME_AS_ANON_KEY_ABOVE
VITE_APP_ENVIRONMENT=production
VITE_APP_NAME="Hệ thống Quản lý Sửa chữa Laptop"
VITE_APP_VERSION=1.0.0
VITE_API_TIMEOUT=15000
VITE_ENABLE_DEVTOOLS=false
VITE_DEFAULT_CURRENCY=VND
VITE_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
VITE_DEFAULT_LOCALE=vi-VN

# ===============================
# DEMO CREDENTIALS (REMOVE IN PRODUCTION)
# ===============================
# 🚨 PRODUCTION: Remove or disable all demo credentials for security
VITE_DEMO_ADMIN_EMAIL=""
VITE_DEMO_ADMIN_PASSWORD=""
VITE_DEMO_STAFF_EMAIL=""

# ===============================
# SECURITY NOTES
# ===============================
# 🔐 Before production deployment:
# 1. Generate all secrets using: openssl rand -base64 [32|64]
# 2. Create new JWT tokens with your JWT_SECRET
# 3. Update all domain references
# 4. Configure real SMTP settings
# 5. Test all authentication flows
# 6. Backup this configuration securely
# 7. Never commit real secrets to version control